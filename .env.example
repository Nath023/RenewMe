NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Server-only Supabase secret key; never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Resend API key and a verified sender address.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=RenewMe <reminders@example.com>
# Long random secret used to authorize the scheduled reminder endpoint.
CRON_SECRET=replace-with-a-long-random-secret
