NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Server-only Supabase secret key; never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Resend API key and a verified sender address.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=RenewMe <reminders@example.com>
# Long random secret used to authorize the scheduled reminder endpoint.
CRON_SECRET=replace-with-a-long-random-secret
# Telegram BotFather token (server-only) and username without the @.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=your_renewme_bot
# Long random URL-safe secret configured on the Telegram webhook.
TELEGRAM_WEBHOOK_SECRET=
# Web Push VAPID keys (public key is exposed to the browser; keep the private key server-only).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
